# Copy to .env for local dev. On Railway, set these in the service's Variables tab.
MONGODB_URI=
JWT_SECRET=                      # must be IDENTICAL to the Python service's JWT_SECRET
FRONTEND_URL=https://thegodstool.com
# Founder/admin emails that get full access for free. Set the SAME value on the Python service too.
# Kept only here (never in code), so it is never sent to anyone's browser.
ADMIN_EMAILS=                    # comma-separated

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

RESEND_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# NEW: the secret you typed when creating the webhook in Razorpay Dashboard → Webhooks.
# Different from RAZORPAY_KEY_SECRET. Without it the webhook endpoint returns 503.
RAZORPAY_WEBHOOK_SECRET=
# Plan IDs: RAZORPAY_PLAN_<LITE|STARTER|PRO|TEAM|ENTERPRISE>_<MONTHLY|YEARLY>_<INR|USD>=plan_xxx

APPSUMO_API_KEY=
